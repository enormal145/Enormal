-- Hàm tạo nút bấm chuyển đổi (Toggle Button: ON/OFF)
local function createToggle(configKey, labelText, posY, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.92, 0, 0, 38)
    btn.Position = UDim2.new(0.04, 0, 0, posY)
    btn.BackgroundColor3 = Color3.fromRGB(22, 38, 62)
    btn.TextColor3 = Color3.fromRGB(240, 240, 240)
    btn.Text = "  " .. labelText
    btn.Font = Enum.Font.GothamSemibold
    btn.TextSize, btn.TextXAlignment = 13, Enum.TextXAlignment.Left
    btn.Parent = mainFrame
    
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    local statusLabel = Instance.new("TextLabel")
    statusLabel.Size = UDim2.new(0, 70, 1, 0)
    statusLabel.Position = UDim2.new(1, -75, 0, 0)
    statusLabel.BackgroundTransparency = 1
    statusLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
    statusLabel.Text = "OFF"
    statusLabel.Font = Enum.Font.GothamBold
    statusLabel.TextSize = 13
    statusLabel.Parent = btn

    btn.MouseButton1Click:Connect(function()
        Config[configKey] = not Config[configKey]
        if Config[configKey] then
            statusLabel.Text = "ON"
            statusLabel.TextColor3 = Color3.fromRGB(0, 255, 128) -- Màu xanh lá sáng khi bật
            btn.BackgroundColor3 = Color3.fromRGB(28, 55, 90)
        else
            statusLabel.Text = "OFF"
            statusLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
            btn.BackgroundColor3 = Color3.fromRGB(22, 38, 62)
        end
        if callback then callback(Config[configKey]) end
    end)
end

-- Hàm tạo ô nhập thông số (TextBox cho Range)
local function createInputBox(configKey, labelText, defaultVal, posY, callback)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.55, 0, 0, 38)
    label.Position = UDim2.new(0.04, 0, 0, posY)
    label.BackgroundColor3 = Color3.fromRGB(22, 38, 62)
    label.TextColor3 = Color3.fromRGB(240, 240, 240)
    label.Text = "  " .. labelText
    label.Font = Enum.Font.GothamSemibold
    label.TextSize, label.TextXAlignment = 13, Enum.TextXAlignment.Left
    label.Parent = mainFrame
    Instance.new("UICorner", label).CornerRadius = UDim.new(0, 6)

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(0.35, 0, 0, 38)
    box.Position = UDim2.new(0.61, 0, 0, posY)
    box.BackgroundColor3 = Color3.fromRGB(15, 25, 42)
    box.TextColor3 = Color3.fromRGB(0, 255, 255)
    box.Text = tostring(defaultVal)
    box.Font = Enum.Font.GothamBold
    box.TextSize = 14
    box.Parent = mainFrame
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 6)

    box.FocusLost:Connect(function()
        local val = tonumber(box.Text)
        if val then
            Config[configKey] = val
            if callback then callback(val) end
        else
            box.Text = tostring(Config[configKey])
        end
    end)
end

