-- Hàm tạo nút Toggle (Bật/Tắt)
local function createToggle(configKey, labelText, posY)
    local btn = create("TextButton", {
        Size = UDim2.new(0.92, 0, 0, 36),
        Position = UDim2.new(0.04, 0, 0, posY),
        BackgroundColor3 = Color3.fromRGB(22, 38, 62),
        TextColor3 = Color3.fromRGB(240, 240, 240),
        Text = "  " .. labelText,
        Font = Enum.Font.GothamSemibold,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        AutoButtonColor = false
    }, mainFrame)
    corner(btn, 6)
    stroke(btn, Color3.fromRGB(35, 60, 95), 1, 0.4)

    local statusLabel = create("TextLabel", {
        Size = UDim2.new(0, 70, 1, 0),
        Position = UDim2.new(1, -75, 0, 0),
        BackgroundTransparency = 1,
        TextColor3 = Color3.fromRGB(150, 150, 150),
        Text = "OFF",
        Font = Enum.Font.GothamBold,
        TextSize = 13
    }, btn)

    btn.MouseButton1Click:Connect(function()
        Config[configKey] = not Config[configKey]
        if Config[configKey] then
            statusLabel.Text = "ON"
            statusLabel.TextColor3 = Color3.fromRGB(0, 255, 128)
            tween(btn, 0.1, { BackgroundColor3 = Color3.fromRGB(28, 60, 100) })
        else
            statusLabel.Text = "OFF"
            statusLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
            tween(btn, 0.1, { BackgroundColor3 = Color3.fromRGB(22, 38, 62) })
        end
    end)
end

