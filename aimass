-- Tìm mục tiêu (Người chơi hoặc NPC gần nhất)
local function getClosestTarget(isNpc)
    local closest = nil
    local shortestDist = math.huge
    local myChar = localPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil end
    local myPos = myChar.HumanoidRootPart.Position

    if isNpc then
        -- Quét qua các thư mục chứa NPC thường gặp trong game (Workspace hoặc mô hình riêng)
        for _, obj in ipairs(Workspace:GetChildren()) do
            if obj:FindFirstChild("Humanoid") and obj:FindFirstChild("HumanoidRootPart") then
                -- Kiểm tra xem có phải người chơi thật không, nếu không thì là NPC
                if not Players:GetPlayerFromCharacter(obj) and obj ~= myChar then
                    local dist = (obj.HumanoidRootPart.Position - myPos).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        closest = obj
                    end
                end
            end
        end
    else
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= localPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                local hum = plr.Character:FindFirstChild("Humanoid")
                if hum and hum.Health > 0 then
                    local dist = (plr.Character.HumanoidRootPart.Position - myPos).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        closest = plr.Character
                    end
                end
            end
        end
    end
    return closest
end

