-- Hàm tạo nút Toggle (Bật/Tắt)
local function createToggle(name, text, posY, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.9, 0, 0, 35)
    btn.Position = UDim2.new(0.05, 0, 0, posY)
    btn.BackgroundColor3 = Color3.fromRGB(25, 45, 75)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Text = "    " .. text
    btn.Font = Enum.Font.GothamSemibold
    btn.TextSize, btn.TextXAlignment = 13, Enum.TextXAlignment.Left
    btn.Parent = mainFrame
    
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    local statusLabel = Instance.new("TextLabel")
    statusLabel.Size = UDim2.new(0, 60, 1, 0)
    statusLabel.Position = UDim2.new(1, -65, 0, 0)
    statusLabel.BackgroundTransparency = 1
    statusLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
    statusLabel.Text = "OFF"
    statusLabel.Font = Enum.Font.GothamBold
    statusLabel.TextSize = 13
    statusLabel.Parent = btn

    local active = false
    btn.MouseButton1Click:Connect(function()
        active = not active
        settingsState[name] = active
        if active then
            statusLabel.Text = "ON"
            statusLabel.TextColor3 = Color3.fromRGB(0, 255, 128) -- Xanh ngọc sáng giống mẫu
            btn.BackgroundColor3 = Color3.fromRGB(30, 65, 100)
        else
            statusLabel.Text = "OFF"
            statusLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
            btn.BackgroundColor3 = Color3.fromRGB(25, 45, 75)
        end
        if callback then callback(active) end
    end)
end

local function createInputBox(name, text, defaultVal, posY, callback)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.5, 0, 0, 35)
    label.Position = UDim2.new(0.05, 0, 0, posY)
    label.BackgroundColor3 = Color3.fromRGB(25, 45, 75)
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.Text = "    " .. text
    label.Font = Enum.Font.GothamSemibold
    label.TextSize, label.TextXAlignment = 13, Enum.TextXAlignment.Left
    label.Parent = mainFrame
    Instance.new("UICorner", label).CornerRadius = UDim.new(0, 6)

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(0.38, 0, 0, 35)
    box.Position = UDim2.new(0.57, 0, 0, posY)
    box.BackgroundColor3 = Color3.fromRGB(15, 25, 45)
    box.TextColor3 = Color3.fromRGB(0, 255, 255)
    box.Text = tostring(defaultVal)
    box.Font = Enum.Font.GothamBold
    box.TextSize = 13
    box.Parent = mainFrame
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 6)

    box.FocusLost:Connect(function()
        local val = tonumber(box.Text)
        if val then
            settingsState[name] = val
            if callback then callback(val) end
        else
            box.Text = tostring(settingsState[name])
        end
    end)
end

