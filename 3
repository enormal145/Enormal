    label.TextColor3 = Color3.fromRGB(240, 240, 240)
    label.Text = "  " .. labelText
    label.Font = Enum.Font.GothamSemibold
    label.TextSize, label.TextXAlignment = 13, Enum.TextXAlignment.Left
    label.Parent = mainFrame
    Instance.new("UICorner", label).CornerRadius = UDim.new(0, 6)

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(0.35, 0, 0, 38)
    box.Position = UDim2.new(0.61, 0, 0, posY)
    box.BackgroundColor3 = Color3.fromRGB(15, 25, 42)
    box.TextColor3 = Color3.fromRGB(0, 255, 255)
    box.Text = tostring(defaultVal)
    box.Font = Enum.Font.GothamBold
    box.TextSize = 14
    box.Parent = mainFrame
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 6)

    box.FocusLost:Connect(function()
        local val = tonumber(box.Text)
        if val then
            Config[configKey] = val
        else
            box.Text = tostring(Config[configKey])
        end
    end)
end

