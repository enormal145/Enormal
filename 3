-- Hàm tìm mục tiêu gần nhất (Player hoặc NPC)
local function getClosestTarget(isNpc)
    local closest = nil
    local shortestDist = math.huge
    local myChar = localPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil end
    local myPos = myChar.HumanoidRootPart.Position

    if isNpc then
        for _, obj in ipairs(Workspace:GetChildren()) do
            if obj:FindFirstChild("Humanoid") and obj:FindFirstChild("HumanoidRootPart") then
                if not Players:GetPlayerFromCharacter(obj) and obj ~= myChar then
                    local hum = obj:FindFirstChild("Humanoid")
                    if hum and hum.Health > 0 then
                        local dist = (obj.HumanoidRootPart.Position - myPos).Magnitude
                        if dist < shortestDist then
                            shortestDist = dist
                            closest = obj
                        end
                    end
                end
            end
        end
    else
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= localPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                local hum = plr.Character:FindFirstChild("Humanoid")
                if hum and hum.Health > 0 then
                    local dist = (plr.Character.HumanoidRootPart.Position - myPos).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        closest = plr.Character
                    end
                end
            end
        end
    end
    return closest
end

-- TÍNH NĂNG SKILL AIM (Định hướng chiêu thức mà KHÔNG KHÓA CAMERA)
-- Khi bạn dùng kỹ năng / nhấn đánh (Tool Activated), nhân vật sẽ tự hướng về mục tiêu trong tích tắc.
local function setupSkillAim(tool)
    if not tool:IsA("Tool") then return end
    
    tool.Activated:Connect(function()
        local myChar = localPlayer.Character
        if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end
        local hrp = myChar.HumanoidRootPart
        
        -- Nếu bật Player Aim
        if Config.PlayerAim then
            local target = getClosestTarget(false)
            if target and target:FindFirstChild("HumanoidRootPart") then
                local tPos = target.HumanoidRootPart.Position
                -- Xoay nhân vật về hướng kẻ địch theo trục Y để tung chiêu chính xác
                hrp.CFrame = CFrame.new(hrp.Position, Vector3.new(tPos.X, hrp.Position.Y, tPos.Z))
            end
        end
        
        -- Nếu bật NPC Aim
        if Config.NpcAim then
            local target = getClosestTarget(true)
            if target and target:FindFirstChild("HumanoidRootPart") then
                local tPos = target.HumanoidRootPart.Position
                hrp.CFrame = CFrame.new(hrp.Position, Vector3.new(tPos.X, hrp.Position.Y, tPos.Z))
            end
        end
    end)
end

-- Lắng nghe nhân vật và vũ khí hiện tại
local function onCharacterAdded(char)
    char.ChildAdded:Connect(setupSkillAim)
    for _, child in ipairs(char:GetChildren()) do
        setupSkillAim(child)
    end
end

if localPlayer.Character then
    onCharacterAdded(localPlayer.Character)
end
localPlayer.CharacterAdded:Connect(onCharacterAdded)


-- Vòng lặp RenderStepped xử lý Tracer và Combat phụ trợ
RunService.RenderStepped:Connect(function()
    local myChar = localPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end

    -- 1. Plr Tracer (Vẽ chỉ dẫn tới người chơi khác)
    if Config.PlrTracer then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= localPlayer and plr.Character and plr.Character:FindFirstChild("Head") then
                local head = plr.Character.Head
                if not head:FindFirstChild("PlrTracerGui") then
                    local bb = Instance.new("BillboardGui")
                    bb.Name = "PlrTracerGui"
                    bb.Size = UDim2.new(0, 40, 0, 40)
                    bb.Adornee = head
                    bb.AlwaysOnTop = true
                    
                    local dot = Instance.new("Frame")
                    dot.Size = UDim2.new(1, 0, 1, 0)
                    dot.BackgroundColor3 = Color3.fromRGB(0, 255, 255)
                    dot.BorderSizePixel = 0
                    Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)
                    dot.Parent = bb
                    bb.Parent = head
                end
            end
        end
    else
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr.Character and plr.Character:FindFirstChild("Head") and plr.Character.Head:FindFirstChild("PlrTracerGui") then
                plr.Character.Head.PlrTracerGui:Destroy()
            end
        end
    end

    -- 2. NPC Tracer (Vẽ chỉ dẫn tới NPC)
    if Config.NpcTracer then
        for _, obj in ipairs(Workspace:GetChildren()) do
            if obj:FindFirstChild("Humanoid") and obj:FindFirstChild("Head") and not Players:GetPlayerFromCharacter(obj) then
                local head = obj.Head
                if not head:FindFirstChild("NpcTracerGui") then
                    local bb = Instance.new("BillboardGui")
                    bb.Name = "NpcTracerGui"
                    bb.Size = UDim2.new(0, 40, 0, 40)
                    bb.Adornee = head
                    bb.AlwaysOnTop = true
                    
                    local dot = Instance.new("Frame")
                    dot.Size = UDim2.new(1, 0, 1, 0)
                    dot.BackgroundColor3 = Color3.fromRGB(255, 120, 0)
                    dot.BorderSizePixel = 0
                    Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)
                    dot.Parent = bb
                    bb.Parent = head
                end
            end
        end
    else
        for _, obj in ipairs(Workspace:GetChildren()) do
            if obj:FindFirstChild("Head") and obj.Head:FindFirstChild("NpcTracerGui") then
                obj.Head.NpcTracerGui:Destroy()
            end
        end
    end
end)
