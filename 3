-- Hàm tạo nút Toggle (Bật/Tắt)
local function createToggle(configKey, labelText, posY)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.92, 0, 0, 38)
    btn.Position = UDim2.new(0.04, 0, 0, posY)
    btn.BackgroundColor3 = Color3.fromRGB(22, 38, 62)
    btn.TextColor3 = Color3.fromRGB(240, 240, 240)
    btn.Text = "  " .. labelText
    btn.Font = Enum.Font.GothamSemibold
    btn.TextSize, btn.TextXAlignment = 13, Enum.TextXAlignment.Left
    btn.Parent = mainFrame
    
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    local statusLabel = Instance.new("TextLabel")
    statusLabel.Size = UDim2.new(0, 70, 1, 0)
    statusLabel.Position = UDim2.new(1, -75, 0, 0)
    statusLabel.BackgroundTransparency = 1
    statusLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
    statusLabel.Text = "OFF"
    statusLabel.Font = Enum.Font.GothamBold
    statusLabel.TextSize = 13
    statusLabel.Parent = btn

    btn.MouseButton1Click:Connect(function()
        Config[configKey] = not Config[configKey]
        if Config[configKey] then
            statusLabel.Text = "ON"
            statusLabel.TextColor3 = Color3.fromRGB(0, 255, 128)
            btn.BackgroundColor3 = Color3.fromRGB(28, 55, 90)
        else
            statusLabel.Text = "OFF"
            statusLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
            btn.BackgroundColor3 = Color3.fromRGB(22, 38, 62)
        end
    end)
end

-- Hàm tạo ô nhập thông số (TextBox)
local function createInputBox(configKey, labelText, defaultVal, posY)
